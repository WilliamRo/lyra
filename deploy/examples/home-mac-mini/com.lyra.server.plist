<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lyra.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USER/lyra/venv/bin/lyra-server</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LYRA_CONFIG</key>
    <string>/Users/USER/lyra/lyra.toml</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/USER/lyra/server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USER/lyra/server.log</string>
</dict>
</plist>
